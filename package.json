{
  "name": "music-hub",
  "version": "1.1.0",
  "description": "Яндекс Музыка + YouTube Music + Spotify в одном окне",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.musichub",
    "productName": "MusicHub",
    "files": ["main.js", "preload.js", "inject.js", "themes.js", "index.html"],
    "win": { "target": "portable" }
  }
}
